# Alientek ATK-DNESP32S3-BOX0: verified 16 MB quad flash, 8 MB octal PSRAM.
# Pin source: 78/xiaozhi-esp32 commit 0d576d3, alientek/atk-dnesp32s3-box0.
# Load last, after sdkconfig.muse.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_ATK_DNESP32S3_BOX0=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Static buffers in PSRAM: Wi-Fi's, lwIP's and BT's, and those marked
# EXT_RAM_BSS_ATTR (Muse's chat turn, the tunnel batch). Without it free
# internal RAM falls to 6 KB pieces and BLE setup can't start its 8 KB task.
# The chip always has PSRAM, so booting without it needn't be allowed.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
# That forces Wi-Fi's TX buffers static, in internal RAM: 8, not 16, at 1.6 KB
# each, which voice over the tunnel doesn't fill.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
# Two-button menu.
CONFIG_LV_FONT_MONTSERRAT_12=y


# Chinese captions; initial bring-up stays awake until battery calibration is validated.
CONFIG_MUSE_CJK_FONT=y
CONFIG_PM_ENABLE=n
CONFIG_HOMEHUB_OTA_ENABLED=n

# OpenAI serves a cross-signed GTS chain; retain root and hostname validation.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
